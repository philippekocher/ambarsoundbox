RewriteEngine On
RewriteBase /

# Keep real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /embed/ or /embed/<identifier> -> player.html
RewriteRule ^embed/[^/]*/?$ player.html [L]

# /<identifier> -> index.html
# RewriteRule ^[^/]+/?$ index.html [L]

# everything else -> index.html
RewriteRule ^.*$ /index.html [L]



